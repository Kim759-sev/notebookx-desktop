{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotebookX Desktop",
  "version": "0.1.0",
  "identifier": "com.notebookx.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotebookX Desktop · 云端 ComfyUI 与 Colab 算力工作站",
        "width": 1340,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
